{
    "name": "grpc",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "libs/grpc/src",
    "projectType": "library",
    "tags": [],
    "targets": {
        "generate": {
            "executor": "nx:run-commands",
            "cache": false,
            "options": {
                "command": "npx buf generate --template buf.gen.yaml && npx prettier --write \"src/lib/generated/**/*.ts\" && npx nx run grpc:lint",
                "cwd": "libs/grpc"
            },
            "outputs": ["{workspaceRoot}/libs/grpc/src/lib/generated"]
        },
        "build": {
            "executor": "@nx/js:tsc",
            "outputs": ["{options.outputPath}"],
            "dependsOn": ["generate"],
            "options": {
                "outputPath": "dist/libs/grpc",
                "main": "libs/grpc/src/index.ts",
                "tsConfig": "libs/grpc/tsconfig.lib.json",
                "assets": ["libs/grpc/*.md"]
            }
        }
    }
}
