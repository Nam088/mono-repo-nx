{
    "name": "nam088",
    "version": "0.0.0",
    "license": "MIT",
    "scripts": {
        "nx": "nx",
        "mikro-orm": "TS_NODE_PROJECT=libs/infra/postgresql/tsconfig.mikro-orm.json node -r ts-node/register/transpile-only ./node_modules/@mikro-orm/cli/cli.js",
        "db:migration:create": "npm run mikro-orm -- migration:create --config libs/infra/postgresql/mikro-orm.config.ts",
        "db:migration:up": "npm run mikro-orm -- migration:up --config libs/infra/postgresql/mikro-orm.config.ts",
        "db:migration:down": "npm run mikro-orm -- migration:down --config libs/infra/postgresql/mikro-orm.config.ts",
        "db:migration:list": "npm run mikro-orm -- migration:list --config libs/infra/postgresql/mikro-orm.config.ts",
        "db:seed": "npm run mikro-orm -- seeder:run --config libs/infra/postgresql/mikro-orm.config.ts",
        "serve:api": "nx serve api",
        "serve:auth": "nx serve auth",
        "build": "nx run-many -t build --all",
        "build:api": "nx build api",
        "build:auth": "nx build auth",
        "grpc:generate": "nx run grpc:generate",
        "test": "nx run-many -t test --all",
        "test:api-e2e": "nx test api-e2e",
        "test:utils": "nx test utils",
        "lint": "nx run-many -t lint --all",
        "lint:staged": "lint-staged",
        "commitlint": "commitlint --from=HEAD~1 --to=HEAD --verbose",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "husky"
    },
    "lint-staged": {
        "{apps,libs}/**/*.{js,jsx,ts,tsx,mjs,cjs}": [
            "eslint --fix --max-warnings=0 --no-warn-ignored",
            "prettier --write"
        ],
        "{apps,libs}/**/*.{json,md,yml,yaml,css,scss,html}": [
            "prettier --write"
        ],
        "{package.json,package-lock.json,nx.json,tsconfig.base.json,docker-compose.yml,README.md}": [
            "prettier --write"
        ]
    },
    "private": true,
    "dependencies": {
        "@bufbuild/protobuf": "^2.9.0",
        "@grpc/grpc-js": "^1.14.3",
        "@grpc/proto-loader": "^0.8.0",
        "@mikro-orm/core": "^7.0.13",
        "@mikro-orm/decorators": "^7.0.13",
        "@mikro-orm/migrations": "^7.0.13",
        "@mikro-orm/nestjs": "^7.0.1",
        "@mikro-orm/postgresql": "^7.0.13",
        "@mikro-orm/reflection": "^7.0.13",
        "@nestjs/common": "^11.1.19",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.1.19",
        "@nestjs/cqrs": "^11.0.3",
        "@nestjs/microservices": "^11.1.19",
        "@nestjs/platform-express": "^11.1.19",
        "@nestjs/swagger": "^11.4.2",
        "axios": "^1.15.2",
        "class-transformer": "^0.5.1",
        "ioredis": "^5.10.1",
        "kafkajs": "^2.2.4",
        "pg": "^8.20.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "uuid": "^14.0.0",
        "zod": "^4.4.1"
    },
    "devDependencies": {
        "@bufbuild/buf": "^1.69.0",
        "@commitlint/cli": "^20.5.3",
        "@commitlint/config-conventional": "^20.5.3",
        "@eslint/js": "^10.0.1",
        "@mikro-orm/cli": "^7.0.13",
        "@mikro-orm/seeder": "^7.0.13",
        "@nestjs/schematics": "^11.1.0",
        "@nestjs/testing": "^11.1.19",
        "@nx/docker": "22.7.1",
        "@nx/eslint": "22.7.1",
        "@nx/eslint-plugin": "22.7.1",
        "@nx/jest": "22.7.1",
        "@nx/js": "22.7.1",
        "@nx/nest": "22.7.1",
        "@nx/node": "22.7.1",
        "@nx/vite": "22.7.1",
        "@nx/vitest": "^22.7.1",
        "@nx/web": "22.7.1",
        "@nx/webpack": "22.7.1",
        "@nx/workspace": "22.7.1",
        "@swc-node/register": "~1.11.1",
        "@swc/core": "~1.15.32",
        "@swc/helpers": "~0.5.21",
        "@types/jest": "^30.0.0",
        "@types/node": "25.6.0",
        "@vitest/coverage-v8": "~4.1.5",
        "eslint": "^10.2.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import-x": "^4.16.2",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-simple-import-sort": "^13.0.0",
        "husky": "^9.1.7",
        "jest": "^30.3.0",
        "jest-environment-node": "^30.3.0",
        "jest-util": "^30.3.0",
        "jsdom": "^29.1.1",
        "jsonc-eslint-parser": "^2.1.0",
        "lint-staged": "^16.4.0",
        "nx": "22.7.1",
        "prettier": "~3.8.3",
        "ts-jest": "^29.4.9",
        "ts-node": "10.9.2",
        "ts-proto": "^2.11.6",
        "tslib": "^2.8.1",
        "tsx": "^4.21.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.59.1",
        "vite": "^8.0.10",
        "vitest": "~4.1.5",
        "webpack-cli": "^7.0.2"
    }
}
